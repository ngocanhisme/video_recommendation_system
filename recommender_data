{"metadata":{"kernelspec":{"language":"python","display_name":"Python 3","name":"python3"},"language_info":{"name":"python","version":"3.12.13","mimetype":"text/x-python","codemirror_mode":{"name":"ipython","version":3},"pygments_lexer":"ipython3","nbconvert_exporter":"python","file_extension":".py"},"kaggle":{"accelerator":"nvidiaTeslaT4","dataSources":[{"sourceType":"datasetVersion","sourceId":18260969}],"isInternetEnabled":true,"language":"python","sourceType":"notebook","isGpuEnabled":false}},"nbformat_minor":4,"nbformat":4,"cells":[{"cell_type":"code","source":"%%writefile kuairand_retrieval_dual_gpu.py\n\"\"\"KuaiRand-1K feature pipeline: preserve both user histories, encode items on TWO GPUs.\n\nThe parent prepares one Parquet metadata file with reasonably sized row groups.\nEach GPU gets a SEPARATE Python process, loads one model, and reads ONLY its\nassigned row groups; neither GPU sits idle waiting for the other. After both\nworkers succeed, the parent joins the item shards into one Parquet file.\nThe parent/worker subprocess approach works with Jupyter's `%run` (unlike\nmultiprocessing.spawn with worker functions defined in notebook __main__).\n\nDisk note: the merge temporarily needs space for both item shards AND the\nfinal item table. Set MERGE_TO_SINGLE_FILE=False to save disk and skip merging:\nthen scan '/kaggle/working/item_table_parts/*.parquet' instead.\n\"\"\"\n\nimport argparse\nimport glob\nimport os\nimport shutil\nfrom pathlib import Path\nimport subprocess\nimport sys\nimport time\n\n# ---------------------- Configuration ----------------------\nROOT = Path(\n    \"/kaggle/input/datasets/nguyenngocanhle/kuairand-1k-parquet/\"\n    \"kaggle/working/kuairand_parquet\"\n)\nOUT = Path(\"/kaggle/working\")\nMODEL_NAME = \"BAAI/bge-small-zh-v1.5\"\nNLP_DIM = 512\nHISTORY_LEN = 150\nRETRIEVAL_WINDOW_LEN = 50\nMAX_GPUS = 2\nTOKEN_BATCH_SIZE = 218\nMIN_TOKEN_BATCH_SIZE = 64\nARROW_BATCH_SIZE = 8192\nMETADATA_ROW_GROUP_SIZE = 65536  # Enables genuinely disjoint GPU row-group reads.\nMAX_LENGTH = 128\nPAD_TO_MULTIPLE_OF = 8  # Tensor-Core-friendly shapes.\nKEEP_RAW_TEXT = False\nMERGE_TO_SINGLE_FILE = True \nDELETE_METADATA_AFTER_SUCCESS = False  # True saves disk; False allows cheap reruns.\nREUSE_METADATA = False  # Set True only if inputs and text-field choices are unchanged.\nHISTORY_CUTOFF_MS = None  # Example: 80th percentile. Set explicit boundary for experiments.\nLOG_INTERVAL_BATCHES = 8  # Per-GPU progress every ~65k videos.\n\nCATEGORIES = [f\"{level}_level_category_name\" for level in\n              (\"first\", \"second\", \"third\", \"fourth\")]\nSIGNALS = [\n    \"is_hate\", \"is_click\", \"long_view\", \"is_like\", \"is_follow\",\n    \"is_comment\", \"is_forward\", \"is_profile_enter\",\n]\nONEHOTS = [f\"onehot_feat{i}\" for i in range(18)]\nUSER_STATIC = [\"user_active_degree\", \"is_lowactive_period\", *ONEHOTS]\n\n\ndef parquet_files(pattern: str) -> list[str]:\n    paths = sorted(p for p in glob.glob(str(ROOT / pattern), recursive=True)\n                   if p.endswith(\".parquet\"))\n    if not paths:\n        raise FileNotFoundError(f\"No Parquet files under {ROOT / pattern}\")\n    return paths\n\n\ndef build_user_table():\n    \"\"\"Keep the ORIGINAL capped exposure history and ALL prior positive events.\"\"\"\n    import polars as pl\n\n    output = OUT / \"user_table.parquet\"\n    log_files = parquet_files(\"log_standard_*/**/*.parquet\")\n    user_files = parquet_files(\"user_features_1k/**/*.parquet\")\n\n    print(f\"[1/3] User histories\", flush=True)\n\n    # Exact requested rule: NOT hate AND (any of 7 positive signals).\n    positive = (\n        (pl.col(\"is_hate\").fill_null(0) == 0)\n        & pl.any_horizontal([\n            pl.col(signal).fill_null(0) == 1\n            for signal in SIGNALS if signal != \"is_hate\"\n        ])\n    )\n    history = (\n        pl.scan_parquet(log_files)\n        .select([\"user_id\", \"video_id\", \"time_ms\", *SIGNALS])\n        .with_columns([pl.col(s).fill_null(0).cast(pl.Int8) for s in SIGNALS])\n        .with_columns(positive.alias(\"is_positive\"))\n        .sort([\"user_id\", \"time_ms\", \"video_id\"])\n        .group_by(\"user_id\")\n        .agg([\n            pl.col(\"video_id\").tail(HISTORY_LEN).alias(\"history_sequence\"),\n            pl.col(\"time_ms\").tail(HISTORY_LEN).alias(\"history_time_ms\"),\n            pl.struct(SIGNALS).tail(HISTORY_LEN).alias(\"history_feedback\"),\n            pl.col(\"video_id\").filter(pl.col(\"is_positive\"))\n              .alias(\"positive_history_sequence\"),\n            pl.col(\"time_ms\").filter(pl.col(\"is_positive\"))\n              .alias(\"positive_history_time_ms\"),\n        ])\n    )\n    users = (\n        pl.scan_parquet(user_files)\n        .select([\"user_id\", *USER_STATIC])\n        .unique(subset=[\"user_id\"], keep=\"first\")\n        .join(history, on=\"user_id\", how=\"left\")\n        .with_columns([\n            pl.col(\"history_sequence\").fill_null([]),\n            pl.col(\"history_time_ms\").fill_null([]),\n            pl.col(\"history_feedback\").fill_null([]),\n            pl.col(\"positive_history_sequence\").fill_null([]),\n            pl.col(\"positive_history_time_ms\").fill_null([]),\n        ])\n    )\n    users.sink_parquet(str(output), compression=\"zstd\")\n    print(f\"Saved {output}\", flush=True)\n\n\ndef build_item_metadata():\n    \"\"\"One joined metadata file; row groups let GPUs read disjoint subsets.\"\"\"\n    import polars as pl\n\n    metadata_path = OUT / \"item_metadata_temp.parquet\"\n    if REUSE_METADATA and metadata_path.exists():\n        print(f\"Reusing metadata: {metadata_path} (check staleness!)\", flush=True)\n        return metadata_path\n    print(\"[2/3] Building item metadata (no statistics in retrieval table)...\", flush=True)\n    video_files = parquet_files(\"video_features_basic_1k/**/*.parquet\")\n    category_files = parquet_files(\"kuairand_video_categories/**/*.parquet\")\n    caption_files = parquet_files(\"kuairand_video_captions/**/*.parquet\")\n    videos = (\n        pl.scan_parquet(video_files)\n        .select([\n            \"video_id\", \"author_id\", \"music_type\", \"video_type\", \"tag\",\n            (pl.col(\"upload_dt\")\n             .cast(pl.Utf8)\n             .str.strptime(pl.Datetime, format=\"%Y-%m-%d\", strict=False)\n             .dt.epoch(time_unit=\"s\")\n             .alias(\"upload_timestamp\")),\n        ])\n        .unique(subset=[\"video_id\"], keep=\"first\")\n    )\n    valid_video_ids = videos.select(\"video_id\")\n    category_rows = (\n        pl.scan_parquet(category_files)\n        .select([pl.col(\"final_video_id\").alias(\"video_id\"), *CATEGORIES])\n        .join(valid_video_ids, on=\"video_id\", how=\"semi\")\n        .unique(subset=[\"video_id\"], keep=\"first\")\n    )\n    caption_rows = (\n        pl.scan_parquet(caption_files)\n        .select([\n            pl.col(\"final_video_id\").alias(\"video_id\"),\n            \"caption\", \"show_cover_text\",\n        ])\n        .join(valid_video_ids, on=\"video_id\", how=\"semi\")\n        .unique(subset=[\"video_id\"], keep=\"first\")\n    )\n    metadata = (\n        videos.join(category_rows, on=\"video_id\", how=\"left\")\n        .join(caption_rows, on=\"video_id\", how=\"left\")\n        .with_columns([\n            pl.col(c).cast(pl.Utf8).fill_null(\"\")\n            for c in [*CATEGORIES, \"caption\", \"show_cover_text\", \"video_type\", \"tag\"]\n        ])\n        .select([\n            \"video_id\", \"author_id\", *CATEGORIES,\n            \"caption\", \"show_cover_text\", \"music_type\",\n            \"upload_timestamp\", \"video_type\", \"tag\",\n        ])\n    )\n    # Explicit row-group sizing is important: worker 0 reads groups 0,2,4,...;\n    # worker 1 reads groups 1,3,5,...; NO duplicate metadata decode.\n    metadata.sink_parquet(\n        str(metadata_path), compression=\"zstd\",\n        row_group_size=METADATA_ROW_GROUP_SIZE,\n    )\n    print(f\"Saved {metadata_path}\", flush=True)\n    return metadata_path\n\n\ndef make_text(data: dict, i: int) -> str:\n    \"\"\"Combine exactly the six requested text fields; keep category/cover first.\"\"\"\n    pieces = []\n    for label, name in zip((\"一级分类\", \"二级分类\", \"三级分类\", \"四级分类\"), CATEGORIES):\n        value = (data[name][i] or \"\").strip()\n        if value and value.upper() != \"UNKNOWN\":\n            pieces.append(f\"{label}：{value}\")\n    cover = (data[\"show_cover_text\"][i] or \"\").strip()\n    caption = (data[\"caption\"][i] or \"\").strip()\n    if cover:\n        pieces.append(f\"封面文字：{cover}\")\n    if caption:\n        pieces.append(f\"标题：{caption}\")\n    return \"\\n\".join(pieces)\n\n\ndef item_schema_from_metadata(source_schema):\n    import pyarrow as pa\n\n    keep_cols = [\n        f.name for f in source_schema\n        if KEEP_RAW_TEXT or f.name not in (\"caption\", \"show_cover_text\")\n    ]\n    schema = pa.schema([\n        *(source_schema.field(name) for name in keep_cols),\n        pa.field(\"nlp_vector\", pa.list_(pa.float32(), NLP_DIM)),\n        pa.field(\"has_nlp_text\", pa.bool_()),\n    ])\n    return keep_cols, schema\n\n\ndef worker(rank: int, workers: int, metadata_path: Path, shard_path: Path):\n    \"\"\"One independent GPU process; input/outputs are disjoint by row group.\"\"\"\n    import numpy as np\n    import pyarrow as pa\n    import pyarrow.parquet as pq\n    import torch\n    import torch.nn.functional as F\n    from transformers import AutoModel, AutoTokenizer\n\n    torch.set_num_threads(1)  # Two GPU workers should not oversubscribe Kaggle's CPUs.\n    gpu = torch.cuda.is_available()\n    device = torch.device(\"cuda:0\" if gpu else \"cpu\")\n    if not gpu:\n        print(\"WARNING: GPU not available: CPU embedding can be very slow\", flush=True)\n    print(f\"Worker {rank}: loading {MODEL_NAME} on {device}\", flush=True)\n\n    tokenizer = AutoTokenizer.from_pretrained(MODEL_NAME, use_fast=True)\n    # Load on CPU first, then convert model to FP16 *once* when moved to GPU.\n    model = AutoModel.from_pretrained(MODEL_NAME)\n    if model.config.hidden_size != NLP_DIM:\n        raise ValueError(f\"Expected NLP_DIM={NLP_DIM}; model has {model.config.hidden_size}\")\n    if gpu:\n        model = model.to(device=device, dtype=torch.float16).eval()\n    else:\n        model = model.to(device).eval()\n\n    pf = pq.ParquetFile(str(metadata_path))\n    assigned = list(range(rank, pf.num_row_groups, workers))\n    expected_rows = sum(pf.metadata.row_group(g).num_rows for g in assigned)\n    keep_cols, schema = item_schema_from_metadata(pf.schema_arrow)\n    print(f\"Worker {rank}: {len(assigned)} row groups, {expected_rows:,} rows\", flush=True)\n\n    def embed(batch_ids):\n        \"\"\"Pad each similarly sized batch instead of max-padding a mixed batch.\"\"\"\n        padded = tokenizer.pad(\n            {\"input_ids\": batch_ids},\n            padding=True,\n            pad_to_multiple_of=PAD_TO_MULTIPLE_OF if gpu else None,\n            return_attention_mask=True,\n            return_tensors=\"pt\",\n        )\n        padded = {key: val.to(device) for key, val in padded.items()}\n        with torch.inference_mode():\n            output = model(**padded).last_hidden_state[:, 0, :].float()\n            result = F.normalize(output, p=2, dim=-1)\n        return result.cpu().numpy().astype(np.float32, copy=False)\n\n    processed = 0\n    batches = 0\n    current_batch_size = TOKEN_BATCH_SIZE if gpu else min(16, TOKEN_BATCH_SIZE)\n    start_time = time.monotonic()\n    # Write a uniquely named partial result until this worker completes cleanly.\n    partial_path = shard_path.with_suffix(\".partial.parquet\")\n    if partial_path.exists():\n        partial_path.unlink()\n    with pq.ParquetWriter(str(partial_path), schema, compression=\"zstd\",\n                          compression_level=1) as writer:\n        for arrow_batch in pf.iter_batches(\n            batch_size=ARROW_BATCH_SIZE, row_groups=assigned, use_threads=True\n        ):\n            data = arrow_batch.to_pydict()\n            texts = [make_text(data, i) for i in range(arrow_batch.num_rows)]\n            valid_idx = [i for i, text in enumerate(texts) if text]\n            vectors = np.zeros((arrow_batch.num_rows, NLP_DIM), dtype=np.float32)\n\n            if valid_idx:\n                # Tokenize ONCE for the whole Arrow batch, then sort by length.\n                # Short texts avoid being padded to the longest caption in a batch.\n                tokenized = tokenizer(\n                    [texts[i] for i in valid_idx],\n                    padding=False, truncation=True, max_length=MAX_LENGTH,\n                    return_attention_mask=False, return_token_type_ids=False,\n                )[\"input_ids\"]\n                order = sorted(range(len(valid_idx)), key=lambda j: len(tokenized[j]))\n                pos = 0\n                while pos < len(order):\n                    indices = order[pos:pos + current_batch_size]\n                    try:\n                        output = embed([tokenized[j] for j in indices])\n                    except torch.cuda.OutOfMemoryError:\n                        if not gpu or current_batch_size <= MIN_TOKEN_BATCH_SIZE:\n                            raise\n                        old_size = current_batch_size\n                        current_batch_size = max(MIN_TOKEN_BATCH_SIZE, current_batch_size // 2)\n                        # The failed batch was not written: retry from SAME pos.\n                        torch.cuda.empty_cache()\n                        print(f\"Worker {rank}: GPU OOM at batch {old_size}; \"\n                              f\"retrying with {current_batch_size}\", flush=True)\n                        continue\n                    vectors[[valid_idx[j] for j in indices]] = output\n                    pos += len(indices)\n\n            fixed = pa.FixedSizeListArray.from_arrays(\n                pa.array(vectors.reshape(-1), type=pa.float32()), NLP_DIM,\n            )\n            arrays = [\n                arrow_batch.column(arrow_batch.schema.get_field_index(name))\n                for name in keep_cols\n            ]\n            arrays.extend([fixed, pa.array([bool(t) for t in texts])])\n            writer.write_table(pa.Table.from_arrays(arrays, schema=schema))\n            processed += arrow_batch.num_rows\n            batches += 1\n            if batches % LOG_INTERVAL_BATCHES == 0:\n                elapsed = max(1e-6, time.monotonic() - start_time)\n                print(f\"Worker {rank}: {processed:,}/{expected_rows:,} items; \"\n                      f\"{processed / elapsed:,.0f} videos/s; batch={current_batch_size}\",\n                      flush=True)\n\n    if processed != expected_rows:\n        raise RuntimeError(f\"Worker {rank} produced {processed:,} rows; expected {expected_rows:,}\")\n    partial_path.replace(shard_path)\n    elapsed = time.monotonic() - start_time\n    print(f\"Worker {rank}: DONE {processed:,} rows in {elapsed / 60:.1f} min\", flush=True)\n\n\ndef merge_shards(shards: list[Path], metadata_path: Path):\n    \"\"\"Append completed worker shards into the original single-file interface.\"\"\"\n    import pyarrow.parquet as pq\n\n    output = OUT / \"item_table.parquet\"\n    partial_output = OUT / \"item_table.partial.parquet\"\n    if partial_output.exists():\n        partial_output.unlink()\n    source = pq.ParquetFile(str(metadata_path))\n    _, expected_schema = item_schema_from_metadata(source.schema_arrow)\n    expected_total = source.metadata.num_rows\n    count = 0\n    try:\n        with pq.ParquetWriter(str(partial_output), expected_schema,\n                              compression=\"zstd\", compression_level=1) as writer:\n            for shard in shards:\n                shard_file = pq.ParquetFile(str(shard))\n                if not shard_file.schema_arrow.equals(expected_schema, check_metadata=False):\n                    raise ValueError(f\"Unexpected schema in {shard}\")\n                for batch in shard_file.iter_batches(batch_size=ARROW_BATCH_SIZE):\n                    writer.write_batch(batch)\n                    count += batch.num_rows\n        if count != expected_total:\n            raise RuntimeError(f\"Item merge row count {count:,} != metadata {expected_total:,}\")\n        partial_output.replace(output)\n        # Deleting completed shards one by one only AFTER the merged file is verified.\n        for shard in shards:\n            shard.unlink()\n        print(f\"[3/3] Saved {count:,} items to {output}\", flush=True)\n    except BaseException:\n        # Preserve completed shards to avoid re-embedding on a disk-related failure.\n        if partial_output.exists():\n            partial_output.unlink()\n        raise\n    return output\n\n\ndef run_embedding(metadata_path: Path):\n    import pyarrow.parquet as pq\n    import torch\n\n    pf = pq.ParquetFile(str(metadata_path))\n    gpu_count = torch.cuda.device_count()\n    num_workers = min(MAX_GPUS, gpu_count, pf.num_row_groups) if gpu_count else 1\n    if not num_workers:\n        raise ValueError(f\"No row groups in {metadata_path}\")\n    if gpu_count:\n        print(f\"[3/3] Found {gpu_count} GPUs; starting {num_workers} separate workers\", flush=True)\n    else:\n        print(\"[3/3] No CUDA GPU found: one CPU worker\", flush=True)\n\n    shards_dir = OUT / \"item_table_parts\"\n    shards_dir.mkdir(parents=True, exist_ok=True)\n    shards = [shards_dir / f\"part-gpu-{i:02d}.parquet\" for i in range(num_workers)]\n    jobs = []\n    script = Path(__file__).resolve()\n    # Respect a pre-existing CUDA_VISIBLE_DEVICES mapping, when Kaggle supplies it.\n    inherited_devices = os.environ.get(\"CUDA_VISIBLE_DEVICES\", \"\")\n    device_tokens = ([token.strip() for token in inherited_devices.split(\",\") if token.strip()]\n                     if inherited_devices else [str(i) for i in range(gpu_count)])\n    if gpu_count and len(device_tokens) < num_workers:\n        raise RuntimeError(\"Fewer CUDA_VISIBLE_DEVICES entries than detected GPUs\")\n    try:\n        for rank, shard in enumerate(shards):\n            # Do not accidentally merge a stale shard from a previous failed run.\n            if shard.exists():\n                shard.unlink()\n            env = os.environ.copy()\n            env[\"CUDA_VISIBLE_DEVICES\"] = device_tokens[rank] if gpu_count else \"\"\n            env[\"TOKENIZERS_PARALLELISM\"] = \"true\"\n            env[\"RAYON_NUM_THREADS\"] = \"2\"  # two workers => 4 tokenizer CPU threads max.\n            env[\"OMP_NUM_THREADS\"] = \"1\"\n            env[\"PYTHONUNBUFFERED\"] = \"1\"\n            log_path = OUT / f\"embedding_gpu_{rank}.log\"\n            logfile = log_path.open(\"w\", encoding=\"utf-8\")\n            cmd = [\n                sys.executable, \"-u\", str(script), \"--worker-rank\", str(rank),\n                \"--num-workers\", str(num_workers),\n                \"--metadata-path\", str(metadata_path),\n                \"--shard-path\", str(shard),\n            ]\n            try:\n                process = subprocess.Popen(cmd, env=env, stdout=logfile,\n                                           stderr=subprocess.STDOUT)\n            finally:\n                logfile.close()\n            jobs.append((process, log_path, shard))\n            print(f\"Started worker {rank} (PID {process.pid}); log: {log_path}\", flush=True)\n\n        seen = [\"\" for _ in jobs]\n        while any(proc.poll() is None for proc, _, _ in jobs):\n            for i, (proc, log_path, _) in enumerate(jobs):\n                if log_path.exists():\n                    # Latest progress without loading large logs into memory.\n                    with log_path.open(\"rb\") as file:\n                        file.seek(max(0, file.seek(0, 2) - 2000))\n                        tail = file.read().decode(\"utf-8\", errors=\"replace\").splitlines()\n                    progress = next((line for line in reversed(tail)\n                                     if \"videos/s\" in line or \"DONE\" in line\n                                     or \"GPU OOM\" in line), \"\")\n                    if progress and progress != seen[i]:\n                        print(progress, flush=True)\n                        seen[i] = progress\n                if proc.poll() is not None and proc.returncode != 0:\n                    raise RuntimeError(f\"GPU worker {i} failed; see {log_path}:\\n\"\n                                       + log_path.read_text(errors=\"replace\")[-5000:])\n            time.sleep(15)\n        for i, (proc, log_path, shard) in enumerate(jobs):\n            if proc.wait() != 0 or not shard.exists():\n                raise RuntimeError(f\"Worker {i} did not complete; log:\\n\"\n                                   + log_path.read_text(errors=\"replace\")[-5000:])\n    except BaseException:\n        for proc, _, _ in jobs:\n            if proc.poll() is None:\n                proc.terminate()\n        for proc, _, _ in jobs:\n            try:\n                proc.wait(timeout=10)\n            except subprocess.TimeoutExpired:\n                proc.kill()\n        raise\n\n    total_shard_rows = sum(pq.ParquetFile(str(shard)).metadata.num_rows for shard in shards)\n    if total_shard_rows != pf.metadata.num_rows:\n        raise RuntimeError(f\"Shard rows {total_shard_rows:,} != metadata rows {pf.metadata.num_rows:,}\")\n    if MERGE_TO_SINGLE_FILE:\n        shard_bytes = sum(shard.stat().st_size for shard in shards)\n        free_bytes = shutil.disk_usage(OUT).free\n        # Peak usage includes full shards plus newly written final file.\n        # Catch obviously insufficient space BEFORE starting an expensive merge.\n        required_bytes = int(shard_bytes * 1.10) + 512 * 1024 * 1024\n        if free_bytes < required_bytes:\n            raise RuntimeError(\n                f\"Not enough free disk to merge into one item_table.parquet: \"\n                f\"{free_bytes / 2**30:.1f} GiB free, ~{required_bytes / 2**30:.1f} GiB needed. \"\n                \"Completed shards are preserved. Set MERGE_TO_SINGLE_FILE=False \"\n                \"to keep a partitioned Parquet dataset, or free disk space.\"\n            )\n        result = merge_shards(shards, metadata_path)\n    else:\n        result = shards_dir / \"*.parquet\"\n        print(f\"Saved {total_shard_rows:,} rows in {shards_dir}\", flush=True)\n        print(f\"Use pl.scan_parquet('{result}')\", flush=True)\n    if DELETE_METADATA_AFTER_SUCCESS:\n        metadata_path.unlink()\n    return result\n\n\ndef main():\n    parser = argparse.ArgumentParser(description=__doc__)\n    parser.add_argument(\"--worker-rank\", type=int, default=None)\n    parser.add_argument(\"--num-workers\", type=int, default=1)\n    parser.add_argument(\"--metadata-path\", type=Path, default=None)\n    parser.add_argument(\"--shard-path\", type=Path, default=None)\n    # ipykernel may provide command-line arguments, but %run runs the script\n    # with its own clean sys.argv; parse_known_args handles either safely.\n    args, _ = parser.parse_known_args()\n    if args.worker_rank is not None:\n        if args.metadata_path is None or args.shard_path is None:\n            parser.error(\"--worker-rank requires --metadata-path and --shard-path\")\n        worker(args.worker_rank, args.num_workers, args.metadata_path, args.shard_path)\n        return\n    OUT.mkdir(parents=True, exist_ok=True)\n    build_user_table()\n    metadata_path = build_item_metadata()\n    #run_embedding(metadata_path)\n    stale = OUT / \"retrieval_targets.parquet\"\n    if stale.exists():\n        print(f\"NOTE: {stale} is STALE from an earlier run; not generated or used.\", flush=True)\n    print(\"Done: original history + all positive history remain in user_table.parquet\", flush=True)\n\n\nif __name__ == \"__main__\":\n    main()\n","metadata":{"_uuid":"8f2839f25d086af736a60e9eeb9